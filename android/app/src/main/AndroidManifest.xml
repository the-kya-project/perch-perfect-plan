<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Auto Backup is OFF deliberately. Capacitor keeps the WebView's
         localStorage in the app's private data dir, and that is where the
         Supabase session lives (persistSession: true) — so with backup on, a
         refresh token and cached bird health data get copied to the user's
         Google Drive. The app is server-backed: every record lives in Supabase
         and comes back on sign-in, so device backup buys the user nothing here
         while widening where their credentials sit. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: these links open the app instead of the browser. The
                 paths MUST match APP_LINK_PREFIXES in src/lib/appLinks.ts
                 (scripts/app-links.test.ts checks). Verified against
                 /.well-known/assetlinks.json on each host. On Android 11 and
                 older, every autoVerify host must verify or none do, so
                 links.thekyaproject.com has to be live before this ships. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.thekyaproject.com" />
                <data android:path="/" />
                <data android:path="/dashboard" />
                <data android:pathPrefix="/dashboard/" />
                <data android:path="/today" />
                <data android:pathPrefix="/today/" />
                <data android:path="/check" />
                <data android:pathPrefix="/check/" />
                <data android:path="/explore" />
                <data android:pathPrefix="/explore/" />
                <data android:path="/household" />
                <data android:pathPrefix="/household/" />
                <data android:path="/household-permissions" />
                <data android:pathPrefix="/household-permissions/" />
                <data android:path="/account" />
                <data android:pathPrefix="/account/" />
                <data android:path="/notifications" />
                <data android:pathPrefix="/notifications/" />
                <data android:path="/past-birds" />
                <data android:pathPrefix="/past-birds/" />
                <data android:path="/remembering" />
                <data android:pathPrefix="/remembering/" />
                <data android:path="/scans" />
                <data android:pathPrefix="/scans/" />
                <data android:path="/sits" />
                <data android:pathPrefix="/sits/" />
                <data android:path="/birds" />
                <data android:pathPrefix="/birds/" />
                <data android:path="/covering" />
                <data android:pathPrefix="/covering/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="links.thekyaproject.com" />
                <data android:pathPrefix="/r/" />
            </intent-filter>

            <!-- The kya:// OAuth deep-link filter was removed. That flow is gone:
                 native sign-in goes through @capgo/capacitor-social-login and
                 supabase.auth.signInWithIdToken(), and the only mention of the
                 scheme left in the codebase is the comment in nativeOAuth.ts
                 recording that it replaced this. Registering a custom scheme the
                 app never produces is dead surface — any other app can claim the
                 same scheme, and an intent arriving on it had no handler here. -->
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
