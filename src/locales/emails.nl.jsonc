  "email.monthly.totalWeighIns": "wegingen",
  // weigh-in
  "email.monthly.totalWeighInsOne": "weging",
  // health checks
  "email.monthly.totalChecks": "gezondheidschecks",
  // health check
  "email.monthly.totalChecksOne": "gezondheidscheck",
  // journal entries
  "email.monthly.totalJournal": "dagboeknotities",
  // journal entry
  "email.monthly.totalJournalOne": "dagboeknotitie",
  // It was a quiet one. Here's an easy way back in.
  "email.monthly.quietPreview": "Het was een rustige maand. Zo pak je de draad makkelijk weer op.",
  // {{hi}} It was a quiet month in the record for {{birds}}. No judgment here. Birds keep you busy, and so does everything else.
  "email.monthly.quietIntro": "{{hi}} Het was een rustige maand in het dossier van {{birds}}. Geen oordeel hoor. Vogels houden je bezig, en al het andere ook.",
  // Start small: pick one
  "email.monthly.startSmall": "Begin klein: kies er één",
  // One entry is all it takes to get the record going again.
  "email.monthly.startSmallNote": "Eén notitie is genoeg om het dossier weer op gang te brengen.",
  // Log one weight
  "email.monthly.start1Title": "Noteer één gewicht",
  // Pop your bird on the scale and you're done.
  "email.monthly.start1Text": "Zet je vogel even op de weegschaal en klaar.",
