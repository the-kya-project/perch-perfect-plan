  "sitter.emergency.firstAidKit": "EHBO-kit",
  // Care guidance from The Kya Project · Parrot Care Bible for Pet Sitters.
  "sitter.emergency.footer": "Verzorgingsadvies van The Kya Project · Parrot Care Bible for Pet Sitters.",
  // not provided by owner.
  "sitter.emergency.notProvided": "niet opgegeven door de eigenaar.",
  // Any contact between a cat/dog and the bird — even with no visible wound.
  "sitter.emergency.pb_bite_signs": "Elk contact tussen een kat/hond en de vogel — ook zonder zichtbare wond.",
  // Treat as life-threatening — bacteria from cat/dog mouths and claws can kill a bird within hours.
  "sitter.emergency.pb_bite_step1": "Behandel dit als levensbedreigend — bacteriën uit de bek en klauwen van katten/honden kunnen een vogel binnen enkele uren doden.",
  // Separate the animals.
  "sitter.emergency.pb_bite_step2": "Scheid de dieren.",
  // Keep the bird warm and quiet.
  "sitter.emergency.pb_bite_step3": "Houd de vogel warm en rustig.",
  // Don't assume the bird is fine.
  "sitter.emergency.pb_bite_step4": "Ga er niet vanuit dat de vogel in orde is.",
  // Call the avian vet immediately — antibiotics within hours are critical.
  "sitter.emergency.pb_bite_step5": "Bel meteen de vogeldierenarts — antibiotica binnen enkele uren zijn cruciaal.",
  // Cat or dog bite or scratch
  "sitter.emergency.pb_bite_title": "Beet of kras van een kat of hond",
  // Active blood from a nail, feather, skin, or beak.
  "sitter.emergency.pb_bleeding_signs": "Actief bloed uit een nagel, veer, huid of snavel.",
  // Stay calm.
  "sitter.emergency.pb_bleeding_step1": "Blijf rustig.",
  // Apply gentle, steady pressure with clean gauze.
  "sitter.emergency.pb_bleeding_step2": "Oefen zachte, gelijkmatige druk uit met schoon gaas.",
  // Use cornstarch or styptic powder on NAILS or FEATHERS only — never in mouth, eyes, or on skin.
  "sitter.emergency.pb_bleeding_step3": "Gebruik maïzena of bloedstelpend poeder alleen op NAGELS of VEREN — nooit in de bek, ogen of op de huid.",
  // Keep warm and quiet.
  "sitter.emergency.pb_bleeding_step4": "Houd hem warm en rustig.",
  // A broken blood feather can bleed heavily — don't pull it yourself unless a vet instructs.
  "sitter.emergency.pb_bleeding_step5": "Een gebroken bloedveer kan hevig bloeden — trek hem er niet zelf uit tenzij een dierenarts dat zegt.",
  // Call the vet if bleeding doesn't stop in 5–10 minutes or the bird seems weak.
  "sitter.emergency.pb_bleeding_step6": "Bel de dierenarts als de bloeding niet stopt binnen 5–10 minuten of de vogel zwak lijkt.",
  // Bleeding
  "sitter.emergency.pb_bleeding_title": "Bloeding",
  // Open-mouth breathing, tail bobbing at rest, wheezing or clicking, wings held away, weakness.
  "sitter.emergency.pb_breathing_signs": "Ademhaling met open bek, wippende staart in rust, piepen of klikken, vleugels van het lichaam af, zwakte.",
  // Stop handling — birds need chest movement to breathe.
  "sitter.emergency.pb_breathing_step1": "Stop met vastpakken — vogels hebben borstbeweging nodig om te ademen.",
  // Move the bird away from fumes, smoke, heat, and stress to fresh air.
  "sitter.emergency.pb_breathing_step2": "Breng de vogel weg van dampen, rook, hitte en stress naar frisse lucht.",
  // Keep warm (~85–90°F if shocky, heat on ONE side only), quiet, and dim.
  "sitter.emergency.pb_breathing_step3": "Houd hem warm (~85–90°F bij shock, verwarm maar aan ÉÉN kant), rustig en in het donker.",
  // Don't mist, bathe, or force water.
  "sitter.emergency.pb_breathing_step4": "Niet besproeien, baden of water opdringen.",
  // Call the avian vet and prepare to transport.
  "sitter.emergency.pb_breathing_step5": "Bel de vogeldierenarts en maak je klaar om te vervoeren.",
  // Trouble breathing / open-mouth
  "sitter.emergency.pb_breathing_title": "Ademhalingsproblemen / open bek",
  // Straining, sitting low, wide stance, tail bobbing, weakness, not passing droppings, swollen lower belly.
  "sitter.emergency.pb_eggbinding_signs": "Persen, laag zitten, brede stand, wippende staart, zwakte, geen ontlasting, gezwollen onderbuik.",
  // Keep warm and calm.
  "sitter.emergency.pb_eggbinding_step1": "Houd hem warm en rustig.",
  // Don't press on the abdomen.
  "sitter.emergency.pb_eggbinding_step2": "Druk niet op de buik.",
  // Don't try to pull an egg.
  "sitter.emergency.pb_eggbinding_step3": "Probeer geen ei eruit te trekken.",
  // Call the avian vet urgently.
  "sitter.emergency.pb_eggbinding_step4": "Bel dringend de vogeldierenarts.",
  // Egg binding (life-threatening)
  "sitter.emergency.pb_eggbinding_title": "Legnood (levensbedreigend)",
  // Flighted parrot has flown out of an open door or window.
  "sitter.emergency.pb_escaped_signs": "Een vliegende papegaai is door een open deur of raam naar buiten gevlogen.",
  // Don't panic. Don't chase wildly.
  "sitter.emergency.pb_escaped_step1": "Raak niet in paniek. Ga niet wild achtervolgen.",
  // Don't take your eyes off the bird — note exactly where it lands.
  "sitter.emergency.pb_escaped_step2": "Houd je ogen op de vogel — onthoud precies waar hij landt.",
  // Call to the bird using familiar words and its name.
  "sitter.emergency.pb_escaped_step3": "Roep de vogel met vertrouwde woorden en zijn naam.",
  // Bring the cage outside if safe, with favorite food in view.
  "sitter.emergency.pb_escaped_step4": "Zet de kooi buiten als dat veilig is, met lievelingseten in het zicht.",
  // Play recordings of the bird or familiar household sounds.
  "sitter.emergency.pb_escaped_step5": "Speel opnames van de vogel of vertrouwde geluiden uit huis af.",
  // Call the owner immediately.
  "sitter.emergency.pb_escaped_step6": "Bel meteen de eigenaar.",
  // Search high (trees, roofs, poles) and wide. Birds often quiet at dusk and call at first light — keep looking.
  "sitter.emergency.pb_escaped_step7": "Zoek hoog (bomen, daken, palen) en in de wijde omgeving. Vogels zijn vaak stil bij schemering en roepen bij het eerste licht — blijf zoeken.",
  // Post in local lost-pet and bird groups; contact nearby vets, shelters, animal control, and Parrot Alert.
  "sitter.emergency.pb_escaped_step8": "Plaats een bericht in lokale groepen voor vermiste huisdieren en vogels; neem contact op met dierenartsen, asielen, dierenambulance en Parrot Alert in de buurt.",
  // Escaped outside
  "sitter.emergency.pb_escaped_title": "Naar buiten ontsnapt",
  // Nonstick cookware overheated, smoke, aerosol, candle, essential oil, cleaner, burnt food.
  "sitter.emergency.pb_fumes_signs": "Oververhitte antiaanbakpannen, rook, spuitbus, kaars, etherische olie, schoonmaakmiddel, aangebrand eten.",
  // Move the bird to fresh air immediately if safe to do so.
  "sitter.emergency.pb_fumes_step1": "Breng de vogel meteen naar frisse lucht als dat veilig kan.",
  // Turn off the source.
  "sitter.emergency.pb_fumes_step2": "Zet de bron uit.",
  // Ventilate the home.
  "sitter.emergency.pb_fumes_step3": "Ventileer het huis.",
  // Keep the bird calm and warm.
  "sitter.emergency.pb_fumes_step4": "Houd de vogel rustig en warm.",
  // Call the avian vet even if the bird looks okay.
  "sitter.emergency.pb_fumes_step5": "Bel de vogeldierenarts, ook als de vogel er goed uitziet.",
  // Fumes or smoke
  "sitter.emergency.pb_fumes_title": "Dampen of rook",
  // Open-mouth breathing, wings held away from body, panting, weakness.
  "sitter.emergency.pb_overheating_signs": "Ademhaling met open bek, vleugels van het lichaam af, hijgen, zwakte.",
  // Move the bird to shade or a cooler room.
  "sitter.emergency.pb_overheating_step1": "Breng de vogel naar de schaduw of een koelere kamer.",
  // Offer cool water.
  "sitter.emergency.pb_overheating_step2": "Bied koel water aan.",
  // Lightly mist the FEET if tolerated.
  "sitter.emergency.pb_overheating_step3": "Besproei licht de POTEN als de vogel dat toelaat.",
  // Don't use ice water.
  "sitter.emergency.pb_overheating_step4": "Gebruik geen ijswater.",
  // Call the vet if the bird doesn't recover quickly.
  "sitter.emergency.pb_overheating_step5": "Bel de dierenarts als de vogel niet snel herstelt.",
  // Overheating
  "sitter.emergency.pb_overheating_title": "Oververhitting",
  // Chewed metal, paint, plant, medication, household chemical, or toxic food.
  "sitter.emergency.pb_poison_signs": "Aangeknaagd metaal, verf, plant, medicijn, huishoudchemicalie of giftig voedsel.",
  // Remove the bird from the substance and the substance from reach.
  "sitter.emergency.pb_poison_step1": "Haal de vogel weg van de stof en de stof buiten bereik.",
  // Do NOT make the bird vomit.
  "sitter.emergency.pb_poison_step2": "Laat de vogel NIET braken.",
  // Save or photograph the packaging or material.
  "sitter.emergency.pb_poison_step3": "Bewaar of fotografeer de verpakking of het materiaal.",
  // Note what was eaten or chewed and when.
  "sitter.emergency.pb_poison_step4": "Noteer wat er is gegeten of aangeknaagd en wanneer.",
  // Call the avian vet or ASPCA Animal Poison Control: (888) 426-4435.
  "sitter.emergency.pb_poison_step5": "Bel de vogeldierenarts of ASPCA Animal Poison Control: (888) 426-4435.",
  // Suspected poisoning
  "sitter.emergency.pb_poison_title": "Vermoedelijke vergiftiging",
  // Uncontrolled movement, loss of balance, unresponsive episode.
  "sitter.emergency.pb_seizure_signs": "Ongecontroleerde bewegingen, verlies van evenwicht, een moment van niet reageren.",
  // Don't restrain the bird.
  "sitter.emergency.pb_seizure_step1": "Houd de vogel niet vast.",
  // Clear nearby hazards from the cage floor.
  "sitter.emergency.pb_seizure_step2": "Haal gevaarlijke voorwerpen weg van de bodem van de kooi.",
  // Dim the room and keep it quiet.
  "sitter.emergency.pb_seizure_step3": "Maak de kamer donker en houd het stil.",
  // Note how long the seizure lasts.
  "sitter.emergency.pb_seizure_step4": "Noteer hoelang de toeval duurt.",
  // Keep the bird warm afterward.
  "sitter.emergency.pb_seizure_step5": "Houd de vogel daarna warm.",
  // Call the avian vet.
  "sitter.emergency.pb_seizure_step6": "Bel de vogeldierenarts.",
  // Seizure
  "sitter.emergency.pb_seizure_title": "Toeval",
  // Any emergency requiring travel.
  "sitter.emergency.pb_transport_signs": "Elk noodgeval waarbij je moet reizen.",
  // Use a small carrier or box lined with a towel — not loose bedding.
  "sitter.emergency.pb_transport_step1": "Gebruik een kleine reismand of doos met een handdoek erin — geen los strooisel.",
  // Warm to ~85–90°F using a wrapped warm water bottle or heat pack on ONE side only.
  "sitter.emergency.pb_transport_step2": "Verwarm tot ~85–90°F met een omwikkelde warmwaterkruik of warmtepack, maar aan ÉÉN kant.",
  // Cover the carrier to keep it dark and quiet.
  "sitter.emergency.pb_transport_step3": "Bedek de reismand zodat het donker en rustig blijft.",
  // Bring the owner's care sheet, any medications, photos of abnormal droppings, and anything the bird ate or chewed (with packaging).
  "sitter.emergency.pb_transport_step4": "Neem het verzorgingsplan van de eigenaar mee, eventuele medicijnen, foto's van afwijkende ontlasting en alles wat de vogel heeft gegeten of aangeknaagd (met verpakking).",
  // Secure in the car. Drive calmly. No blasting music or vents at the bird.
  "sitter.emergency.pb_transport_step5": "Zet hem vast in de auto. Rij rustig. Geen keiharde muziek of ventilatie op de vogel gericht.",
  // Call ahead so the vet is ready when you arrive.
  "sitter.emergency.pb_transport_step6": "Bel van tevoren zodat de dierenarts klaarstaat als je aankomt.",
  // Transport to the vet
  "sitter.emergency.pb_transport_title": "Vervoer naar de dierenarts",
  // Poison control
  "sitter.emergency.poisonControl": "Gifcentrum",
