  // Push notifications aren't available in preview links.
  "notifSettings.pushUnavailable": "Pushmeldingen zijn niet beschikbaar in voorbeeldlinks.",
  // Reminders
  "notifSettings.reminders": "Herinneringen",
  // Review the care plan before a sit
  "notifSettings.reviewCarePlan": "Het zorgplan nakijken voor een oppas",
