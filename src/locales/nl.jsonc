  // Founding member: see the founding members
  "flock.founders.badgeLink": "Oprichtend lid: bekijk de oprichtende leden",
  // Founding members can choose to appear here. When the first one does, you'll find them on this page.
  "flock.founders.empty": "Oprichtende leden kunnen kiezen of ze hier verschijnen. Zodra de eerste dat doet, vind je ze op deze pagina.",
