  "sitter.emergency.quickPlaybooks": "Snelle draaiboeken",
  // Stay calm.
  "sitter.emergency.rule1": "Blijf rustig.",
  // Keep {{name}} warm — about 85–90°F if sick or shocky. Heat on one side only.
  "sitter.emergency.rule2": "Houd {{name}} warm — ongeveer 85–90°F als hij ziek of in shock is. Verwarm maar aan één kant.",
  // Keep the bird quiet, dim, and minimally handled.
  "sitter.emergency.rule3": "Houd de vogel rustig, in het donker en pak hem zo min mogelijk op.",
  // Call the avian vet and prepare to transport.
  "sitter.emergency.rule4": "Bel de vogeldierenarts en maak je klaar om te vervoeren.",
