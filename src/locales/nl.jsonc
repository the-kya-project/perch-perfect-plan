  "sitter.concern.title": "Er is iets mis met {{name}}",
  // Take a breath. If it's urgent, call the vet first.
  "sitter.duo.concern.line": "Haal even adem. Is het dringend, bel dan eerst de dierenarts.",
  // Who to call
