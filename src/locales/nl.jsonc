  // Scans
  "ownerHeader.scans": "Gezondheidschecks",
  // Quick questions to track health. Pet sitters are asked to run a health check daily. Flags show up fast when something's off.
  "ownerOnboarding.activityBody": "Korte vragen om de gezondheid te volgen. Oppassen wordt gevraagd elke dag een gezondheidscheck te doen. Als er iets niet klopt, zie je het snel.",
  // Daily health checks.
  "ownerOnboarding.activityHeadline": "Dagelijkse gezondheidschecks.",
  // You can add a bird anytime from Home — tap the ? to revisit the tour.
  "ownerOnboarding.addAnytime": "Je kunt altijd een vogel toevoegen vanuit Home — tik op de ? om de rondleiding opnieuw te bekijken.",
  // Add my first bird
  "ownerOnboarding.addMyFirstBird": "Mijn eerste vogel toevoegen",
  // Back
  "ownerOnboarding.back": "Terug",
  // What The Kya Project is up to. Field notes, deep dives, community and other ways to get involved. Read when you have a minute.
  "ownerOnboarding.exploreBody": "Waar The Kya Project mee bezig is. Veldnotities, verdiepende verhalen, community en andere manieren om mee te doen. Lees het als je even tijd hebt.",
  // Stories, education, conservation.
  "ownerOnboarding.exploreHeadline": "Verhalen, educatie, natuurbehoud.",
  // Tap a bird to see their care plan, weight history, journal, identity, and photos. The works.
  "ownerOnboarding.flockBody": "Tik op een vogel om het verzorgingsplan, de gewichtsgeschiedenis, het dagboek, de identiteit en foto's te zien. Alles.",
  // Each bird gets a record.
  "ownerOnboarding.flockHeadline": "Elke vogel krijgt een dossier.",
  // They live here while they're with you — until they're adopted, or until you decide they're staying. (It happens.)
  "ownerOnboarding.fostersBody": "Ze staan hier zolang ze bij jou zijn — tot ze geadopteerd worden, of tot je besluit dat ze blijven. (Dat gebeurt.)",
  // Fostering a bird?
  "ownerOnboarding.fostersHeadline": "Vang je een vogel op?",
  // Got it
  "ownerOnboarding.gotIt": "Begrepen",
  // When a bird moves to a new home their full record can transfer with them. Care plan, history, identity, everything.
  "ownerOnboarding.handoffBody": "Als een vogel naar een nieuw thuis gaat, kan het volledige dossier mee. Verzorgingsplan, geschiedenis, identiteit, alles.",
  // Saying goodbye? Hand off the record.
  "ownerOnboarding.handoffHeadline": "Afscheid nemen? Draag het dossier over.",
  // Hi, {{name}}.
  "ownerOnboarding.hiName": "Hoi {{name}}.",
  // Here you'll find daily check-ins, your flock, and anything happening soon. It's the screen you'll open most.
  "ownerOnboarding.homeBody": "Hier vind je de dagelijkse check-ins, je vogels en alles wat binnenkort gebeurt. Dit scherm open je het vaakst.",
  // Home is where you land.
  "ownerOnboarding.homeHeadline": "Home is je startpunt.",
  // Spouse, partner, kids, roommates — add them as household. They get access to your care plan and health checks so they can step in when needed.
  "ownerOnboarding.householdBody": "Partner, kinderen, huisgenoten — voeg ze toe aan je huishouden. Ze krijgen toegang tot je verzorgingsplan en gezondheidschecks, zodat ze kunnen bijspringen als het nodig is.",
  // Family who shares the care?
  "ownerOnboarding.householdHeadline": "Deel je de zorg met je gezin?",
  // Next
  "ownerOnboarding.next": "Volgende",
  // Now the fun part — let's set up your first bird.
  "ownerOnboarding.nowTheFunPart": "Nu het leuke deel — laten we je eerste vogel toevoegen.",
  // Anytime you need a refresher, the ? is right up top.
  "ownerOnboarding.refresher": "Wil je het nog eens zien? De ? staat altijd bovenin.",
  // Show me around
  "ownerOnboarding.showMeAround": "Laat me rondkijken",
  // Pet sitters get a temporary link — just for the trip. Household members get more details and a daily checklist.
  "ownerOnboarding.sitsBody": "Oppassen krijgen een tijdelijke link — alleen voor die reis. Leden van je huishouden krijgen meer details en een dagelijkse checklist.",
  // Going away? Set up a sit.
  "ownerOnboarding.sitsHeadline": "Ga je weg? Plan een oppasperiode.",
  // Skip and add my bird
  "ownerOnboarding.skipAndAddMyBird": "Overslaan en mijn vogel toevoegen",
  // Skip for now
  "ownerOnboarding.skipForNow": "Nu overslaan",
  // Skip tour
  "ownerOnboarding.skipTour": "Rondleiding overslaan",
  // {{n}} of {{total}}
  "ownerOnboarding.stepOf": "{{n}} van {{total}}",
  // That's the tour.
  "ownerOnboarding.thatsTheTour": "Dat was de rondleiding.",
  // Sits starting, hatch days, a foster settling in — whatever's worth knowing today shows up here first.
  "ownerOnboarding.todayBody": "Oppasperiodes die beginnen, uitkomstdagen, een opvangvogel die aan het wennen is — alles wat vandaag belangrijk is, zie je hier als eerste.",
  // Today, at a glance.
  "ownerOnboarding.todayHeadline": "Vandaag, in één oogopslag.",
  // A quick walkthrough first, then we'll set up your bird.
  "ownerOnboarding.welcomeBody": "Eerst een korte rondleiding, daarna voegen we je vogel toe.",
  // Welcome
  "ownerOnboarding.welcomeEyebrow": "Welkom",
  // Welcome.
  "ownerOnboarding.welcomeHeadline": "Welkom.",
  // Back to bird record
  "ownerScan.backAria": "Terug naar het dossier van je vogel",
  // Back to record
  "ownerScan.backToRecord": "Terug naar dossier",
  // Emergency contacts
  "ownerScan.emergencyContacts": "Noodcontacten",
  // All good today
  "ownerScan.eyebrowGreen": "Alles goed vandaag",
  // Call your vet now
  "ownerScan.eyebrowRed": "Bel nu je dierenarts",
  // Keep a close eye
  "ownerScan.eyebrowYellow": "Houd het goed in de gaten",
  // A quick once-over to make sure {{name}}'s feeling like themselves.
  "ownerScan.intro": "Een snelle controle om te zien of {{name}} zich zoals altijd voelt.",
  // Couldn't log the health check.
  "ownerScan.logFailed": "Kon de gezondheidscheck niet noteren.",
  // Health check — Kya & Co.
  "ownerScan.metaTitle": "Gezondheidscheck — Kya & Co.",
  // Nothing concerning logged. Keep following the care plan and watching for any changes.
  "ownerScan.msgGreen": "Niets zorgelijks genoteerd. Blijf het verzorgingsplan volgen en let op veranderingen.",
  // This may be urgent. Call the owner and the avian vet now. Keep the bird warm, quiet, and minimize handling.
  "ownerScan.msgRed": "Dit kan dringend zijn. Bel nu de eigenaar en de vogeldierenarts. Houd de vogel warm en rustig, en pak hem zo min mogelijk op.",
  // Two or more concerning signs together — this combination is worth a call. Message the owner now and call the avian vet if it continues or worsens.
  "ownerScan.msgYellowMulti": "Twee of meer zorgelijke signalen tegelijk — deze combinatie is een telefoontje waard. Stuur de eigenaar nu een bericht en bel de vogeldierenarts als het aanhoudt of erger wordt.",
  // Something may be off. Message the owner, take photos if helpful, and keep monitoring. Call the avian vet if this continues or appears with other signs.
  "ownerScan.msgYellowOne": "Er is misschien iets niet in orde. Stuur de eigenaar een bericht, maak foto's als dat helpt en blijf het in de gaten houden. Bel de vogeldierenarts als het aanhoudt of samen met andere signalen optreedt.",
  // Log health check
  "ownerScan.submit": "Gezondheidscheck noteren",
  // this bird
  "ownerScan.thisBird": "deze vogel",
  // Health check — {{name}}
  "ownerScan.title": "Gezondheidscheck — {{name}}",
  // What you flagged
  "ownerScan.whatYouFlagged": "Wat je hebt gemarkeerd",
