  // You will never be in trouble for calling too soon.
  "sitter.emergency.callSoon": "Je krijgt nooit problemen omdat je te vroeg belt.",
  // Carrier
  "sitter.emergency.carrier": "Reismand",
  // Critical info
  "sitter.emergency.criticalInfo": "Cruciale informatie",
