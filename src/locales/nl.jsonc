  "notifSettings.reviewCarePlanDesc": "Een herinnering een paar dagen voordat een oppas begint.",
  // Remind me to review the care plan before an upcoming sit.
  "notifSettings.rowCarePlanDesc": "Herinner me eraan het verzorgingsplan na te kijken voor een komende oppasperiode.",
  // Care plan update reminder
  "notifSettings.rowCarePlanTitle": "Herinnering verzorgingsplan bijwerken",
  // A gentle reminder if it's been a while since the last entry.
  "notifSettings.rowCheckinDesc": "Een vriendelijke herinnering als je al een tijdje niets hebt genoteerd.",
  // Check-in reminders
  "notifSettings.rowCheckinTitle": "Herinneringen om in te checken",
  // Tell me when a sitter posts a new daily log entry during a sit.
  "notifSettings.rowSitterLogDesc": "Laat het me weten als een oppas tijdens een oppasperiode een nieuwe dagelijkse notitie plaatst.",
