  // Your gift card
  "giftThanks.cardHeading": "Je cadeaukaart",
  // Gift code
  "giftThanks.codeLabel": "Cadeaucode",
  // Finishing up your gift…
  "giftThanks.finishing": "Je cadeau wordt afgerond…",
  // {{percent}}% of this gift goes to parrot rescue and conservation. Thank you for that, too.
  "giftThanks.giving": "{{percent}}% van dit cadeau gaat naar de opvang en bescherming van papegaaien. Ook daarvoor bedankt.",
  // Where some of it goes
  "giftThanks.givingTitle": "Waar een deel naartoe gaat",
  // Redeem it at app.thekyaproject.com/redeem: sign in or create a free account, then enter the code.
  "giftThanks.howTo": "Wissel het in op app.thekyaproject.com/redeem: log in of maak een gratis account aan en vul dan de code in.",
  // We'll email it to {{email}} on {{date}}. Your receipt, with the code, is on its way to you now.
  "giftThanks.lineEmail": "We mailen het op {{date}} naar {{email}}. Je betaalbewijs, met de code, is nu naar je onderweg.",
  // Print the card below or forward the code. Your receipt, with the code, is on its way to you now.
  "giftThanks.lineSelf": "Print de kaart hieronder of stuur de code door. Je betaalbewijs, met de code, is nu naar je onderweg.",
  // We couldn't find this gift. If you just paid, check your email for the receipt, or reply to it and we'll help.
  "giftThanks.notFound": "We konden dit cadeau niet vinden. Heb je net betaald? Kijk dan in je e-mail voor het betaalbewijs, of beantwoord die e-mail en we helpen je verder.",
