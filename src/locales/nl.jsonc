  "ownerTabs.explore": "Ontdekken",
  // Health
  "ownerTabs.health": "Gezondheid",
  // Home
  "ownerTabs.home": "Home",
  // Primary
  "ownerTabs.navAria": "Hoofdmenu",
  // Sits
  "ownerTabs.sits": "Oppasperiodes",
  // Do what feels right. Your avian vet can guide anything else.
  "passingGuidance.burialDisclaimerOwner": "Doe wat goed voelt. Je vogeldierenarts kan je met de rest helpen.",
  // Do what feels right. {{ownerName}} will guide anything else.
  "passingGuidance.burialDisclaimerSitter": "Doe wat goed voelt. {{ownerName}} helpt je met de rest.",
  // {{ownerName}} would like to bury {{name}} or arrange cremation once back home. Here's how to keep them safe until then.
  "passingGuidance.burialIntro": "{{ownerName}} wil {{name}} begraven of een crematie regelen na thuiskomst. Zo houd je ze veilig tot dan.",
  // {{ownerName}} will take it from here once home. You've done the hard part.
  "passingGuidance.burialReassure": "{{ownerName}} neemt het over na thuiskomst. Jij hebt het moeilijkste gedaan.",
  // Keeping {{name}} safe until then
  "passingGuidance.burialTitle": "{{name}} veilig houden tot dan",
  // Call the vet
  "passingGuidance.callVet": "Bel de dierenarts",
  // Call {{name}}
  "passingGuidance.callVetNamed": "Bel {{name}}",
  // Gentle starting points, not medical advice. The vet will guide the specifics.
  "passingGuidance.necropsyDisclaimer": "Voorzichtige eerste stappen, geen medisch advies. De dierenarts helpt je met de details.",
  // {{ownerName}} would like a necropsy to understand what happened. It's time sensitive, so it helps to act soon.
  "passingGuidance.necropsyIntro": "{{ownerName}} wil graag een necropsie om te begrijpen wat er is gebeurd. Dit is tijdgevoelig, dus het helpt om snel te handelen.",
  // Keeping {{name}} cool for the vet
  "passingGuidance.necropsyTitle": "{{name}} koel houden voor de dierenarts",
  // Depending on how far the vet is, you may need to keep {{name}} cool for the drive. Call the vet, they'll tell you exactly how to transport them.
  "passingGuidance.necropsyTransport": "Afhankelijk van hoe ver de dierenarts is, moet je {{name}} misschien koel houden tijdens de rit. Bel de dierenarts, zij vertellen je precies hoe je ze kunt vervoeren.",
  // Refrigerate, never freeze. Freezing damages what the vet needs to look at.
  "passingGuidance.necropsyWarning": "Koelen, nooit invriezen. Invriezen beschadigt wat de dierenarts moet onderzoeken.",
  // Prepare {{name}} for burial or cremation
  "passingGuidance.pathChoice.burial": "Maak {{name}} klaar voor begrafenis of crematie",
  // Keep {{name}} for a necropsy
  "passingGuidance.pathChoice.necropsy": "Bewaar {{name}} voor een necropsie",
  // Bring {{name}} to the vet
  "passingGuidance.pathChoice.vet": "Breng {{name}} naar de dierenarts",
  // Bring them to the vet. Calling ahead helps them be ready.
  "passingGuidance.stepBringToVet": "Breng ze naar de dierenarts. Van tevoren bellen helpt hen zich voor te bereiden.",
  // Put them in the freezer until you're ready.
  "passingGuidance.stepFreezerOwner": "Leg ze in de vriezer tot je er klaar voor bent.",
  // Put them in the freezer until {{ownerName}} is ready.
  "passingGuidance.stepFreezerSitter": "Leg ze in de vriezer tot {{ownerName}} er klaar voor is.",
  // Place them in a plastic bag.
  "passingGuidance.stepPlasticBag": "Leg ze in een plastic zak.",
  // Place them in a plastic bag or a small box for the trip.
  "passingGuidance.stepPlasticBagBox": "Leg ze in een plastic zak of een klein doosje voor onderweg.",
  // Put them in the refrigerator, not the freezer.
  "passingGuidance.stepRefrigerate": "Leg ze in de koelkast, niet in de vriezer.",
  // Gently wrap {{name}} in a towel.
  "passingGuidance.stepWrapTowel": "Wikkel {{name}} voorzichtig in een handdoek.",
  // Gently wrap {{name}} in a towel or soft cloth.
  "passingGuidance.stepWrapTowelCloth": "Wikkel {{name}} voorzichtig in een handdoek of zachte doek.",
  // The vet will guide you from there.
  "passingGuidance.vetDisclaimer": "De dierenarts helpt je verder.",
  // {{ownerName}} would like {{name}} brought to the vet, who can care for them and talk through options.
  "passingGuidance.vetIntro": "{{ownerName}} wil dat {{name}} naar de dierenarts wordt gebracht, die voor ze kan zorgen en de opties met je kan bespreken.",
  // Bringing {{name}} to the vet
  "passingGuidance.vetTitle": "{{name}} naar de dierenarts brengen",
  // Call the vet before you go, they'll let you know if there's anything you need to do for the drive.
  "passingGuidance.vetTransport": "Bel de dierenarts voordat je gaat, zij laten je weten of er iets is wat je voor de rit moet doen.",
