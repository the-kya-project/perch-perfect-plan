  "sitter.caresheet.reference": "Owner-provided reference. For general care guidance, see the <guide>Care guide</guide>.",
  "sitter.caresheet.subtitle": "Everything the owner wants you to know.",
  "sitter.caresheet.title": "{{name}}'s care sheet.",
  "sitter.concern.pauseError": "Couldn't pause the reminders. Please try again.",
  "sitter.emergency.callAvianVet": "Call avian vet",
  "sitter.emergency.callBackup": "Call backup contact",
  "sitter.emergency.callEmergencyVet": "Call emergency vet",
  "sitter.emergency.callOwner": "Call owner",
  "sitter.emergency.callSoon": "You will never be in trouble for calling too soon.",
  "sitter.emergency.carrier": "Carrier",
  "sitter.emergency.criticalInfo": "Critical info",
  "sitter.emergency.firstAidKit": "First-aid kit",
  "sitter.emergency.footer": "Care guidance from The Kya Project · Parrot Care Bible for Pet Sitters.",
  "sitter.emergency.notProvided": "not provided by owner.",
  "sitter.emergency.pb_bite_signs": "Any contact between a cat/dog and the bird — even with no visible wound.",
  "sitter.emergency.pb_bite_step1": "Treat as life-threatening — bacteria from cat/dog mouths and claws can kill a bird within hours.",
  "sitter.emergency.pb_bite_step2": "Separate the animals.",
  "sitter.emergency.pb_bite_step3": "Keep the bird warm and quiet.",
  "sitter.emergency.pb_bite_step4": "Don't assume the bird is fine.",
  "sitter.emergency.pb_bite_step5": "Call the avian vet immediately — antibiotics within hours are critical.",
  "sitter.emergency.pb_bite_title": "Cat or dog bite or scratch",
  "sitter.emergency.pb_bleeding_signs": "Active blood from a nail, feather, skin, or beak.",
  "sitter.emergency.pb_bleeding_step1": "Stay calm.",
  "sitter.emergency.pb_bleeding_step2": "Apply gentle, steady pressure with clean gauze.",
  "sitter.emergency.pb_bleeding_step3": "Use cornstarch or styptic powder on NAILS or FEATHERS only — never in mouth, eyes, or on skin.",
  "sitter.emergency.pb_bleeding_step4": "Keep warm and quiet.",
  "sitter.emergency.pb_bleeding_step5": "A broken blood feather can bleed heavily — don't pull it yourself unless a vet instructs.",
  "sitter.emergency.pb_bleeding_step6": "Call the vet if bleeding doesn't stop in 5–10 minutes or the bird seems weak.",
  "sitter.emergency.pb_bleeding_title": "Bleeding",
  "sitter.emergency.pb_breathing_signs": "Open-mouth breathing, tail bobbing at rest, wheezing or clicking, wings held away, weakness.",
  "sitter.emergency.pb_breathing_step1": "Stop handling — birds need chest movement to breathe.",
  "sitter.emergency.pb_breathing_step2": "Move the bird away from fumes, smoke, heat, and stress to fresh air.",
  "sitter.emergency.pb_breathing_step3": "Keep warm (~85–90°F if shocky, heat on ONE side only), quiet, and dim.",
  "sitter.emergency.pb_breathing_step4": "Don't mist, bathe, or force water.",
  "sitter.emergency.pb_breathing_step5": "Call the avian vet and prepare to transport.",
  "sitter.emergency.pb_breathing_title": "Trouble breathing / open-mouth",
  "sitter.emergency.pb_eggbinding_signs": "Straining, sitting low, wide stance, tail bobbing, weakness, not passing droppings, swollen lower belly.",
  "sitter.emergency.pb_eggbinding_step1": "Keep warm and calm.",
  "sitter.emergency.pb_eggbinding_step2": "Don't press on the abdomen.",
  "sitter.emergency.pb_eggbinding_step3": "Don't try to pull an egg.",
  "sitter.emergency.pb_eggbinding_step4": "Call the avian vet urgently.",
  "sitter.emergency.pb_eggbinding_title": "Egg binding (life-threatening)",
  "sitter.emergency.pb_escaped_signs": "Flighted parrot has flown out of an open door or window.",
  "sitter.emergency.pb_escaped_step1": "Don't panic. Don't chase wildly.",
  "sitter.emergency.pb_escaped_step2": "Don't take your eyes off the bird — note exactly where it lands.",
  "sitter.emergency.pb_escaped_step3": "Call to the bird using familiar words and its name.",
  "sitter.emergency.pb_escaped_step4": "Bring the cage outside if safe, with favorite food in view.",
  "sitter.emergency.pb_escaped_step5": "Play recordings of the bird or familiar household sounds.",
  "sitter.emergency.pb_escaped_step6": "Call the owner immediately.",
  "sitter.emergency.pb_escaped_step7": "Search high (trees, roofs, poles) and wide. Birds often quiet at dusk and call at first light — keep looking.",
  "sitter.emergency.pb_escaped_step8": "Post in local lost-pet and bird groups; contact nearby vets, shelters, animal control, and Parrot Alert.",
  "sitter.emergency.pb_escaped_title": "Escaped outside",
  "sitter.emergency.pb_fumes_signs": "Nonstick cookware overheated, smoke, aerosol, candle, essential oil, cleaner, burnt food.",
  "sitter.emergency.pb_fumes_step1": "Move the bird to fresh air immediately if safe to do so.",
  "sitter.emergency.pb_fumes_step2": "Turn off the source.",
  "sitter.emergency.pb_fumes_step3": "Ventilate the home.",
  "sitter.emergency.pb_fumes_step4": "Keep the bird calm and warm.",
  "sitter.emergency.pb_fumes_step5": "Call the avian vet even if the bird looks okay.",
  "sitter.emergency.pb_fumes_title": "Fumes or smoke",
  "sitter.emergency.pb_overheating_signs": "Open-mouth breathing, wings held away from body, panting, weakness.",
  "sitter.emergency.pb_overheating_step1": "Move the bird to shade or a cooler room.",
  "sitter.emergency.pb_overheating_step2": "Offer cool water.",
  "sitter.emergency.pb_overheating_step3": "Lightly mist the FEET if tolerated.",
  "sitter.emergency.pb_overheating_step4": "Don't use ice water.",
  "sitter.emergency.pb_overheating_step5": "Call the vet if the bird doesn't recover quickly.",
  "sitter.emergency.pb_overheating_title": "Overheating",
  "sitter.emergency.pb_poison_signs": "Chewed metal, paint, plant, medication, household chemical, or toxic food.",
  "sitter.emergency.pb_poison_step1": "Remove the bird from the substance and the substance from reach.",
  "sitter.emergency.pb_poison_step2": "Do NOT make the bird vomit.",
  "sitter.emergency.pb_poison_step3": "Save or photograph the packaging or material.",
  "sitter.emergency.pb_poison_step4": "Note what was eaten or chewed and when.",
  "sitter.emergency.pb_poison_step5": "Call the avian vet or ASPCA Animal Poison Control: (888) 426-4435.",
  "sitter.emergency.pb_poison_title": "Suspected poisoning",
  "sitter.emergency.pb_seizure_signs": "Uncontrolled movement, loss of balance, unresponsive episode.",
  "sitter.emergency.pb_seizure_step1": "Don't restrain the bird.",
  "sitter.emergency.pb_seizure_step2": "Clear nearby hazards from the cage floor.",
  "sitter.emergency.pb_seizure_step3": "Dim the room and keep it quiet.",
  "sitter.emergency.pb_seizure_step4": "Note how long the seizure lasts.",
  "sitter.emergency.pb_seizure_step5": "Keep the bird warm afterward.",
  "sitter.emergency.pb_seizure_step6": "Call the avian vet.",
  "sitter.emergency.pb_seizure_title": "Seizure",
  "sitter.emergency.pb_transport_signs": "Any emergency requiring travel.",
  "sitter.emergency.pb_transport_step1": "Use a small carrier or box lined with a towel — not loose bedding.",
  "sitter.emergency.pb_transport_step2": "Warm to ~85–90°F using a wrapped warm water bottle or heat pack on ONE side only.",
  "sitter.emergency.pb_transport_step3": "Cover the carrier to keep it dark and quiet.",
  "sitter.emergency.pb_transport_step4": "Bring the owner's care sheet, any medications, photos of abnormal droppings, and anything the bird ate or chewed (with packaging).",
  "sitter.emergency.pb_transport_step5": "Secure in the car. Drive calmly. No blasting music or vents at the bird.",
  "sitter.emergency.pb_transport_step6": "Call ahead so the vet is ready when you arrive.",
  "sitter.emergency.pb_transport_title": "Transport to the vet",
