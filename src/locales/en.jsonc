  "sitterOnboarding.emergency": "Emergency",
  "sitterOnboarding.overview.body": "This app has everything you need to care for {{names}}: a daily routine and a quick health check, a parrot care guide, and an emergency button if anything's ever wrong. It takes about a minute to learn — we'll point out each part.",
  "sitterOnboarding.overview.cta": "Got it, show me around",
  "sitterOnboarding.overview.title": "How this app works",
  "sitterOnboarding.skip": "Skip",
  "sitterOnboarding.step.birdCard.multi": "Tap a bird to open their day and check in on them.",
  "sitterOnboarding.step.birdCard.single": "Tap {{name}} to open {{their}} day.",
  "sitterOnboarding.step.birdSwitcher": "Switch between the birds you're caring for up here — each has their own day and care plan.",
  "sitterOnboarding.step.carePlanLink": "For everything specific to {{name}}, tap here for {{their}} full care plan — your source of truth for caring for {{them}}.",
