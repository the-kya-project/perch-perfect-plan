  "sitter.concern.line_f": "If she's sick, hurt, or has passed, here's what to do.",
  "sitter.concern.line_m": "If he's sick, hurt, or has passed, here's what to do.",
  "sitter.concern.line_n": "If they're sick, hurt, or have passed, here's what to do.",
  "sitter.concern.pauseError": "Couldn't pause the reminders. Please try again.",
  "sitter.concern.title": "Something's wrong with {{name}}",
