{
  // SERVER-ONLY email catalog (namespace: "emails"). Source language: English.
  // Loaded only by src/lib/i18n/emailI18n.server.ts — never shipped to the
  // browser. Dutch is produced by scripts/i18n-translate.mjs (emails pair).
  // {{placeholders}} are interpolated by the builders; values are pre-escaped
  // per field at the call site, so the catalog carries no HTML escaping beyond
  // what the original English literals already had.

  // ---- Shared shell chrome ----
  "email.shell.fieldNotes": "From the field notes",
  "email.shell.footNote": "Kya &amp; Co. — by The Kya Project",

  // ---- Flock Club shared chrome (src/lib/flockClub.ts) ----
  // Used by every email built on the new layout. The disclaimer is emitted by
  // the footer on every one of them and must never be written into a body
  // block — that is the whole point of it living here.
  "email.flock.lockupAlt": "Kya &amp; Co.",
  "email.flock.signName": "Brittany",
  "email.flock.signTitle": "Founder, The Kya Project",
  "email.flock.disclaimer": "Kya &amp; Co. doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.",
  "email.flock.settings": "Settings",
  "email.flock.unsubscribe": "Unsubscribe",
  "email.flock.byLine": "by The Kya Project",
  "email.flock.pillFlockmate": "Hi, flockmate",

  // ---- The onboarding letter layout (letterShell) ----
  // Shared by the seven letters: the masthead label, the hand-off line, the
  // founder line under the sign-off, and the two product-moment labels.
  "email.series.lockupAlt": "Kya &amp; Co.",
  "email.series.letterOf": "Letter {{n}} of 7",
  "email.series.nextLabel": "Next letter · Day {{day}}",
  "email.series.signTitle": "Founder, The Kya Project",
  "email.moment.inTheApp": "In the app",
  "email.moment.example": "Example",

  // ---- The monthly letter (buildMonthlyEmail) ----
  // Sent on the 2nd, recapping the previous month. The design handback
  // hardcodes "September"/"October" in its copy and hardcodes each stat as a
  // sample value; both are parameterised here so the letter works in any
  // month. English wording is the handback's, unchanged.
  "email.monthly.mast": "{{month}} letter",
  "email.monthly.kicker": "Your month with {{birds}}",
  "email.monthly.heading": "{{prevMonth}}, in the record",
  "email.monthly.preview": "A look back at the month, a care note, and the latest from The Kya Project.",
  "email.monthly.subjectOne": "{{birdName}}'s {{prevMonth}}",
  "email.monthly.subjectMany": "Your flock's {{prevMonth}}",
  "email.monthly.hi": "Hi {{firstName}},",
  "email.monthly.lead": "Here's a look back at {{birds}}'s month: what the record shows, a few things you wrote down, and a care note for the month ahead.",

  // Per-bird stat cards. Each sentence is one key; none is assembled from
  // fragments. The three narrative variants exist because "a little tighter"
  // is a claim about the numbers and must not be printed when it is false.
  "email.monthly.weightLabel": "Weight in {{prevMonth}}",
  "email.monthly.weightTypical": "typical this month",
  "email.monthly.weightRange": "{{min}}–{{max}} g across {{count}} weigh-ins in {{days}} days",
  "email.monthly.weightRangeOne": "One weigh-in in {{days}} days",
  "email.monthly.narrowerThan": "{{bird}}'s readings sat inside a {{range}} g range this month, a little tighter than {{prevMonth}}'s {{prevRange}} g.",
  "email.monthly.widerThan": "{{bird}}'s readings sat inside a {{range}} g range this month, a little wider than {{prevMonth}}'s {{prevRange}} g.",
  "email.monthly.rangeOnly": "{{bird}}'s readings sat inside a {{range}} g range this month.",
  "email.monthly.checksLabel": "Health checks",
  "email.monthly.checksValue": "{{count}} of {{days}} days",
  "email.monthly.checksNoneFlagged": "Nothing flagged",
  "email.monthly.checksFlagged": "{{count}} flagged",
  "email.monthly.journalLabel": "Journal",
  "email.monthly.journalValue": "{{count}} entries",
  "email.monthly.journalValueOne": "1 entry",
  "email.monthly.journalPhotos": "and {{count}} photos this month",
  "email.monthly.journalNoPhotos": "no photos this month",
  "email.monthly.planLabel": "Care plan",
  // The handback shows "Food and Routine updated", but care_plans is one wide
  // row with no per-section timestamps, so which sections changed is not
  // knowable. planUpdated is kept for when it is; until then the plain form
  // is used rather than naming sections we cannot stand behind.
  "email.monthly.planUpdated": "{{sections}} updated",
  "email.monthly.planUpdatedPlain": "Updated",
  "email.monthly.planNotUpdated": "Not updated in {{prevMonth}}",
  "email.monthly.journalQuoteLabel": "Journal · {{date}}",
  "email.monthly.recordLink": "Open {{bird}}'s record",

  // The quiet block (a bird with little logged) and the quiet letter (every
  // bird quiet). Deliberately not a telling-off — see notGrade.
  "email.monthly.quietLead": "{{bird}}'s record was quieter this month. One weight is enough to pick the trend back up, and everything from before is still there.",
  // The handback disagrees with itself here: 09-monthly-quiet.html and
  // new-strings.json say "Last on the record" / "Weight · <date>", while the
  // quiet block inside 08-monthly.html says "Last weight" / "Logged <date>".
  // new-strings.json wins — it is the named string source and template 09
  // agrees with it, two against one. Both places use these keys, so the quiet
  // block and the quiet letter cannot drift apart again.
  "email.monthly.lastLabel": "Last on the record",
  "email.monthly.lastWeight": "Weight · {{date}}",
  "email.monthly.lastCheckLabel": "Last health check",
  "email.monthly.nothingYet": "Nothing on the record yet",
  "email.monthly.notGrade": "None of this is a score. A quieter month in the log is still a month you spent together.",
  "email.monthly.qLead": "A new month is an easy place to pick things back up. One weight is enough to start again, and everything you logged before is still on the record.",
  "email.monthly.qStartLabel": "Two easy ways back in",
  "email.monthly.qStart1": "<b>Log a weight.</b> It takes about a minute, and it picks the trend up where you left it.",
  "email.monthly.qStart2": "<b>Run a health check.</b> A few questions about how your bird looks and behaves today.",
  "email.monthly.qCta": "Log a weight",

  "email.monthly.comingLabel": "Coming up in {{month}}",
  "email.monthly.careLabel": "This month's care note",
  "email.monthly.fieldLabel": "From the field notes",
  "email.monthly.fieldMeta": "{{minutes}} minute read",
  "email.monthly.fieldLink": "Read the article",
  "email.monthly.cta": "Open Kya &amp; Co.",
  "email.monthly.reply": "What have your birds been up to? Reply and tell me. Every one comes straight to me.",
  "email.monthly.signoff": "Warmly,<br>Brittany",
  "email.monthly.healthNote": "This app doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.",
  "email.monthly.foot": "You're getting this because you have a Kya &amp; Co. account. You can turn off the monthly letter in Settings at any time.",

  // Month names, for the masthead, the heading and every {{month}} above.
  // Dutch needs its own; a date library would not be localized here.
  "email.monthly.month.1": "January",
  "email.monthly.month.2": "February",
  "email.monthly.month.3": "March",
  "email.monthly.month.4": "April",
  "email.monthly.month.5": "May",
  "email.monthly.month.6": "June",
  "email.monthly.month.7": "July",
  "email.monthly.month.8": "August",
  "email.monthly.month.9": "September",
  "email.monthly.month.10": "October",
  "email.monthly.month.11": "November",
  "email.monthly.month.12": "December",

  // The twelve care notes, one per send month, from the handback.
  "email.monthly.care.1.alt": "A sun conure looking over its shoulder",
  "email.monthly.care.1.title": "Book the wellness visit",
  "email.monthly.care.1.n1": "<b>Put a date on the calendar.</b> A yearly check with an avian vet gives you both a baseline to compare against, even when everything seems fine.",
  "email.monthly.care.1.n2": "<b>Bring the record.</b> Open the vet summary before you go and jot down anything you've been wondering about, however small.",
  "email.monthly.care.1.n3": "<b>Practice the carrier.</b> A few short, calm visits to the carrier in the weeks before make the trip easier on everyone.",
  "email.monthly.care.2.alt": "A white cockatoo with a yellow crest, holding food in one foot",
  "email.monthly.care.2.title": "Make food take a bit of work",
  "email.monthly.care.2.n1": "<b>Start easy.</b> Wrap a favorite treat loosely in plain paper, or tuck it into a paper cup. The first puzzle should be one your bird can solve.",
  "email.monthly.care.2.n2": "<b>Build up slowly.</b> Once your bird has the idea, try a foraging toy, or hide pieces of the usual food around the cage.",
  "email.monthly.care.2.n3": "<b>Keep an eye on the bowl.</b> Make sure your bird is still eating enough while they learn. Their weight trend will tell you if something's shifted.",
  "email.monthly.care.3.alt": "A golden conure perched on a bare branch",
  "email.monthly.care.3.title": "Look after their feet",
  "email.monthly.care.3.n1": "<b>Mix up the perches.</b> Different widths and textures let feet work in different ways. Natural branches from bird-safe wood are a good place to start.",
  "email.monthly.care.3.n2": "<b>Check for wear.</b> Look for loose fittings, cracks, and smooth, worn spots, and replace anything that's seen better days.",
  "email.monthly.care.3.n3": "<b>Watch how they stand.</b> In a calm moment, notice how your bird grips and balances. If something looks different from usual, ask your vet.",
  "email.monthly.care.4.alt": "A rainbow lorikeet preening its tail feathers on a rope perch",
  "email.monthly.care.4.title": "Make time for a bath",
  "email.monthly.care.4.n1": "<b>Offer a few options.</b> Some birds love a shallow dish, some prefer a light mist, and some would rather sit with you near the shower.",
  "email.monthly.care.4.n2": "<b>Keep it warm and easy.</b> Lukewarm water, a warm room, and plenty of time to dry off afterward.",
  "email.monthly.care.4.n3": "<b>Let your bird decide.</b> If they're not interested today, try again another day. Note what they like in the journal.",
  "email.monthly.care.5.alt": "A green eclectus parrot on a thin branch among leaves",
  "email.monthly.care.5.title": "Give the toy box a once-over",
  "email.monthly.care.5.n1": "<b>Check what you have.</b> Fraying rope, loose parts, and cracked plastic are worth replacing before they become a problem.",
  "email.monthly.care.5.n2": "<b>Rotate a few.</b> Put some toys away and bring back ones your bird hasn't seen in a while. Old favorites often feel new again.",
  "email.monthly.care.5.n3": "<b>Notice what gets chewed.</b> Which toys get destroyed and which get ignored is a good clue for what to offer next.",
  "email.monthly.care.6.alt": "A green parrot with an orange face perched in a leafy tree",
  "email.monthly.care.6.title": "Add something new to the bowl",
  "email.monthly.care.6.n1": "<b>Try one new vegetable.</b> Offer it more than once. Many parrots need to see a food several times before they'll taste it.",
  "email.monthly.care.6.n2": "<b>Change the shape.</b> Chopped, whole, grated, or threaded on a skewer can each land differently.",
  "email.monthly.care.6.n3": "<b>Ask about the balance.</b> The right mix of pellets, fresh food, and seed depends on species, so it's a good question for your next vet visit.",
  "email.monthly.care.7.alt": "A close-up of a green conure with red markings on its face",
  "email.monthly.care.7.title": "Do a gentle once-over",
  "email.monthly.care.7.n1": "<b>Pick a calm moment.</b> Sitting close during a quiet time is enough. There's no need to hold your bird still.",
  "email.monthly.care.7.n2": "<b>Look at nails, beak, and eyes.</b> You're learning what's usual for your bird, so a change stands out later.",
  "email.monthly.care.7.n3": "<b>Write down what you see.</b> A short journal note, and a photo if you can, gives you something to compare next time. If something has changed, ask your vet.",
  "email.monthly.care.8.alt": "A green budgerigar perched in front of a dark aviary",
  "email.monthly.care.8.title": "Get ready for the unexpected",
  "email.monthly.care.8.n1": "<b>Fill in the Emergency section.</b> Add your avian vet, the nearest emergency clinic, and who to call if you can't be reached.",
  "email.monthly.care.8.n2": "<b>Keep a carrier ready.</b> Somewhere easy to reach, with a towel and a small container of food.",
  "email.monthly.care.8.n3": "<b>Share the plan.</b> Make sure anyone who helps with your bird knows where to find it.",
  "email.monthly.care.9.alt": "An African grey parrot looking up from a red perch indoors",
  "email.monthly.care.9.title": "Keep the air clean at home",
  "email.monthly.care.9.n1": "<b>Be careful with nonstick pans.</b> Overheated nonstick cookware can release fumes that are very dangerous to birds. Keep your bird well away from the kitchen when you cook.",
  "email.monthly.care.9.n2": "<b>Go easy on scents.</b> Aerosol sprays, scented candles, plug-in air fresheners, and strong cleaning products are best kept away from where your bird spends time.",
  "email.monthly.care.9.n3": "<b>Let fresh air in.</b> Open a window when you clean or cook, and keep your bird in another room until the air clears.",
  "email.monthly.care.10.alt": "A white cockatiel with orange cheeks beside a wooden nest box",
  "email.monthly.care.10.title": "Protect a good night's sleep",
  "email.monthly.care.10.n1": "<b>Keep bedtime steady.</b> A regular time, a dark room, and quiet help most parrots settle.",
  "email.monthly.care.10.n2": "<b>Notice what wakes them.</b> Late TV, passing headlights, or a busy hallway can interrupt sleep more than you'd think.",
  "email.monthly.care.10.n3": "<b>Write down the routine.</b> Add bedtime to the Routine section of the care plan so anyone helping out keeps it the same.",
  "email.monthly.care.11.alt": "Two hyacinth macaws sitting close together on a rope",
  "email.monthly.care.11.title": "Spend a few minutes on training",
  "email.monthly.care.11.n1": "<b>Keep sessions short.</b> A few minutes at a time, ending while your bird is still interested.",
  "email.monthly.care.11.n2": "<b>Start with something simple.</b> Stepping up, or touching a target stick, builds trust and makes everyday care easier.",
  "email.monthly.care.11.n3": "<b>Reward what you want to see.</b> A favorite treat and your attention go a long way. Note progress in the journal.",
  "email.monthly.care.12.alt": "A green macaw with a red forehead perched in an aviary",
  "email.monthly.care.12.title": "Plan for a busy house",
  "email.monthly.care.12.n1": "<b>Keep the basics steady.</b> Meals, sleep, and time out of the cage matter more when the house is full or the routine shifts.",
  "email.monthly.care.12.n2": "<b>Give your bird a quiet spot.</b> Somewhere calm to retreat to when there are guests, noise, or new things around.",
  "email.monthly.care.12.n3": "<b>Watch for hazards.</b> Open doors, candles, decorations, and unfamiliar foods are worth an extra look.",

  // Shared onboarding footer.
  "email.onboarding.foot": "You're getting this because you have a Kya & Co. account and haven't finished setting up. Each of these setup notes is sent at most once.",

  // ---- Daily log (owner) ----
  "email.dailyLog.subject": "{{birdName}}: daily health check logged — all clear",
  "email.dailyLog.kicker": "Daily update",
  "email.dailyLog.heading": "{{bird}}'s sitter logged an all-clear health check",
  "email.dailyLog.body": "{{sitter}} just completed {{bird}}'s daily health check and nothing was flagged.",
  "email.dailyLog.cta": "View the health check",
  "email.dailyLog.foot": "You're getting this because daily health-check emails are on. You can turn them off in the app's notification settings.",
  "email.dailyLog.text": "{{birdName}}'s sitter logged an all-clear daily health check.\n\nView it: {{link}}",

  // ---- Care plan reminder (owner) ----
  "email.carePlanReminder.subject": "{{birdName}} has a sit coming up — review the care plan?",
  "email.carePlanReminder.kicker": "Care plan check-in",
  "email.carePlanReminder.heading": "{{bird}} has a sit coming up",
  "email.carePlanReminder.body": "It's been a while since {{bird}}'s care plan was updated, and a sit starts soon. Take a minute to review it so your sitter has the latest.",
  "email.carePlanReminder.cta": "Review the care plan",
  "email.carePlanReminder.foot": "You're getting this because care-plan reminder emails are on. You can turn them off in the app's notification settings.",
  "email.carePlanReminder.text": "{{birdName}} has a sit coming up — review the care plan: {{link}}",

  // ---- Household invite (account-less invitee; sender's locale) ----
  "email.householdInvite.subject": "{{inviterName}} invited you to help care for {{birdNames}}",
  "email.householdInvite.kicker": "Household invite",
  "email.householdInvite.heading": "{{inviter}} invited you to help care for {{birds}}",
  "email.householdInvite.body": "{{inviter}} invited you to help care for {{birds}} on Kya & Co.. You'll be able to see each bird's care plan, weight, journal, and health checks — and log weights, journal entries, and daily health checks alongside {{inviter}}. You won't be able to change the care plan or who has access; {{inviter}} stays the owner. This invite expires in 14 days.",
  "email.householdInvite.cta": "Accept the invite",
  "email.householdInvite.foot": "If you didn't expect this, you can ignore this email — nothing happens until you accept. The invite link expires in 14 days.",
  "email.householdInvite.text": "{{inviterName}} invited you to help care for {{birdNames}} on Kya & Co..\n\nYou'll be able to view each bird's record and log weights, journal entries, and health checks. You can't change the care plan or access; {{inviterName}} stays the owner.\n\nAccept (expires in 14 days): {{link}}\n\nIf you didn't expect this, you can ignore this email.",

  // ---- Handoff invite (account-less recipient; sender's locale) ----
  "email.handoffInvite.subject": "{{senderName}} is handing off {{birdName}} to you",
  "email.handoffInvite.kicker": "Bird handoff",
  "email.handoffInvite.heading": "{{sender}} is handing off {{bird}} to you",
  "email.handoffInvite.body": "{{sender}} wants to pass {{bird}}'s full record to you on Kya & Co. — care plan, identity, weight history, journal, and moments, so you have everything they learned while caring for {{bird}}. Once you accept, the record is yours and {{sender}} no longer has access. This link expires in 14 days.",
  "email.handoffInvite.cta": "Review the handoff",
  "email.handoffInvite.foot": "If you weren't expecting this, you can ignore this email — nothing transfers until you accept.",
  "email.handoffInvite.text": "{{senderName}} is handing off {{birdName}} to you on Kya & Co..\n\nYou'll receive {{birdName}}'s full record (care plan, identity, weights, journal, moments). Once you accept, it's yours and {{senderName}} no longer has access.\n\nReview (expires in 14 days): {{link}}",

  // ---- Handoff accepted (sender/original owner) ----
  "email.handoffAccepted.subject": "{{birdName}}'s handoff is complete",
  "email.handoffAccepted.kicker": "Handoff complete",
  "email.handoffAccepted.heading": "{{bird}} has a new home",
  "email.handoffAccepted.body": "{{who}} accepted the handoff, so {{bird}}'s record is now theirs and has left your account. You'll find a memory of {{bird}} in Past birds. Thank you for taking such good care of them.",
  "email.handoffAccepted.cta": "View Past birds",
  "email.handoffAccepted.foot": "This is a one-time confirmation. There's nothing else to do.",
  "email.handoffAccepted.text": "{{who}} accepted the handoff. {{birdName}}'s record is now theirs and has left your account. A memory is saved in Past birds.",

  // ---- Handoff declined (sender/original owner) ----
  "email.handoffDeclined.subject": "{{birdName}}'s handoff was declined",
  "email.handoffDeclined.kicker": "Handoff declined",
  "email.handoffDeclined.heading": "{{bird}}'s handoff wasn't accepted",
  "email.handoffDeclined.body": "The handoff for {{bird}} was declined, so nothing changed — {{bird}} is still in your account and you still have full access. You can start a new handoff whenever you're ready.",
  "email.handoffDeclined.cta": "Open Kya & Co.",
  "email.handoffDeclined.foot": "No action needed.",
  "email.handoffDeclined.text": "{{birdName}}'s handoff was declined. Nothing changed — {{birdName}} is still in your account.",

  // ---- Onboarding: add first bird ----
  "email.onboardingAddBird.subject": "Your bird's record is ready when you are",
  "email.onboardingAddBird.kicker": "Getting set up",
  // Greeting halves, composed in the builder (so Dutch can say "jouw"/"Jouw").
  "email.onboardingAddBird.hiName": "{{firstName}}, your",
  "email.onboardingAddBird.hiNoName": "Your",
  "email.onboardingAddBird.heading": "{{hi}} flock page is still empty",
  "email.onboardingAddBird.body": "Adding a bird takes about a minute — a name and a species is enough to start. Everything else (care plan, weights, photos) can come whenever you like.",
  "email.onboardingAddBird.cta": "Add your bird",
  "email.onboardingAddBird.text": "Adding a bird takes about a minute — a name and a species is enough to start.\n\nAdd your bird: {{link}}",

  // ---- Onboarding: start care plan ----
  "email.onboardingCarePlan.subject": "A little about {{birdName}} goes a long way",
  "email.onboardingCarePlan.kicker": "Getting set up",
  "email.onboardingCarePlan.heading": "Start {{bird}}'s care plan",
  "email.onboardingCarePlan.body": "You know {{bird}}'s routine by heart — food, quirks, the little rules. Writing even one section down means family, sitters, and anyone helping out can care for {{bird}} the way you would. Add a section at a time, in any order.",
  "email.onboardingCarePlan.cta": "Open {{bird}}'s care plan",
  "email.onboardingCarePlan.text": "Writing down even one care-plan section means anyone helping out can care for {{birdName}} the way you would.\n\nOpen the care plan: {{link}}",

  // ---- Onboarding: log first weight ----
  "email.onboardingFirstWeight.subject": "Log {{birdName}}'s first weight",
  "email.onboardingFirstWeight.kicker": "Getting set up",
  "email.onboardingFirstWeight.heading": "{{bird}}'s weight tells you what words can't",
  "email.onboardingFirstWeight.body": "Birds hide illness and weight is often the first signal. Log {{bird}}'s weight once and you've started a baseline; keep it up (a kitchen scale and ten seconds) and the app will show you the trend at a glance.",
  "email.onboardingFirstWeight.cta": "Log a weight",
  "email.onboardingFirstWeight.text": "Birds hide illness and weight is often the first signal. Log {{birdName}}'s first weight to start a baseline: {{link}}",

  // ---- Onboarding: run health scan ----
  "email.onboardingHealthScan.subject": "Two minutes a day builds {{birdName}}'s health record",
  "email.onboardingHealthScan.kicker": "Getting set up",
  "email.onboardingHealthScan.heading": "Run {{bird}}'s health scan every day",
  "email.onboardingHealthScan.body": "The daily health scan takes about two minutes. Log it every day and document what you see, whether something seems off or everything is normal.<br /><br />The normal days count too, because they're what make a change visible. Every scan becomes part of {{bird}}'s record, so at the vet you can show exactly what changed, and when.",
  "email.onboardingHealthScan.cta": "Run today's health scan",
  "email.onboardingHealthScan.text": "The daily health scan takes about two minutes. Log it every day and document what you see, whether something seems off or everything is normal. It all becomes part of {{birdName}}'s record you can bring to the vet.\n\nRun today's health scan: {{link}}",

  // ---- Onboarding: weight trend unlocked ----
  "email.onboardingWeightTrend.subject": "{{birdName}}'s baseline has begun",
  "email.onboardingWeightTrend.kicker": "Nice work",
  "email.onboardingWeightTrend.heading": "{{bird}}'s first weight is on the record",
  "email.onboardingWeightTrend.body": "Every weigh-in from here builds {{bird}}'s trend right on the record and in the vet summary. Weighing at the same time of day (before breakfast works well) keeps the trend honest.",
  "email.onboardingWeightTrend.cta": "See {{bird}}'s weight page",
  "email.onboardingWeightTrend.text": "{{birdName}}'s first weight is logged. Every weigh-in from here builds the trend on the record and in the vet summary.\n\nSee the weight page: {{link}}",

  // ---- Sit assigned (household caregiver) ----
  "email.sitAssigned.subject": "You're covering {{birdNames}} — {{dateRange}}",
  "email.sitAssigned.kicker": "Sit assigned",
  "email.sitAssigned.heading": "{{owner}} asked you to cover {{birds}}",
  "email.sitAssigned.body": "{{owner}} set you as the lead for a sit covering {{birds}} from {{range}}. You're the point person for that stretch — everything you'll need is in your care view.",
  "email.sitAssigned.cta": "Open your care view",
  "email.sitAssigned.foot": "You're getting this because {{owner}} assigned you to help with this sit on Kya & Co.",
  "email.sitAssigned.text": "{{ownerName}} asked you to cover {{birdNames}} from {{dateRange}}. You're the lead for this sit.\n\nOpen your care view: {{link}}",

  // ---- Sit updated (household caregiver) ----
  "email.sitUpdated.subject": "A sit you're covering changed — {{dateRange}}",
  "email.sitUpdated.kicker": "Sit updated",
  "email.sitUpdated.heading": "{{owner}} updated a sit you're covering",
  "email.sitUpdated.body": "{{owner}} changed {{change}} for the sit you're leading. It now covers {{birds}} from {{range}}. Your care view has the latest.",
  "email.sitUpdated.cta": "See the update",
  "email.sitUpdated.foot": "You're getting this because a sit you're covering on Kya & Co. changed.",
  "email.sitUpdated.text": "{{ownerName}} changed {{changeSummary}} for a sit you're covering. It now covers {{birdNames}} from {{dateRange}}.\n\nSee the update: {{link}}",
  // changeSummary halves + joiner, composed in the sit-updated server fn.
  "email.sitUpdated.changeDates": "the dates",
  "email.sitUpdated.changeBirds": "which birds you're covering",
  "email.sitUpdated.changeJoin": " and ",
  "email.sitUpdated.changeFallback": "some details",

  // ---- Sit cancelled (household caregiver) ----
  "email.sitCancelled.subject": "Cancelled: your sit covering {{birdNames}} ({{dateRange}})",
  "email.sitCancelled.kicker": "Sit cancelled",
  "email.sitCancelled.heading": "{{owner}} cancelled a sit you were covering",
  "email.sitCancelled.body": "You're no longer covering {{birds}}. The sit from {{range}} has been cancelled, so there's nothing you need to do for it. {{owner}} will be in touch if that changes.",
  "email.sitCancelled.cta": "Open the app",
  "email.sitCancelled.foot": "You're getting this because a sit you were covering on Kya & Co. was cancelled.",
  "email.sitCancelled.text": "{{ownerName}} cancelled the sit covering {{birdNames}} from {{dateRange}}. You're no longer covering it — nothing you need to do.\n\nOpen the app: {{link}}",

  // ---- Flagged-scan alert (owner) — the 15th, inline in sitter.functions.ts ----
  "email.scanAlert.subjectUrgent": "{{birdName}}: health concern flagged by your sitter",
  "email.scanAlert.subjectCalm": "{{birdName}}: your sitter flagged something to check",
  "email.scanAlert.kickerUrgent": "Health concern",
  "email.scanAlert.kickerCalm": "Worth a check",
  "email.scanAlert.heading": "{{bird}}'s daily health check needs your eyes",
  "email.scanAlert.body": "{{sitter}} just submitted a health check and flagged the following:",
  "email.scanAlert.reasonsFallback": "See the full health check in the app.",
  "email.scanAlert.notesLabel": "Sitter notes",
  "email.scanAlert.cta": "View the full health check",
  "email.scanAlert.disclaimer": "This app doesn't diagnose illness and isn't a substitute for veterinary care. If something seems off, contact an avian veterinarian.",
  "email.scanAlert.textHeading": "{{birdName}}'s daily health check needs your eyes.",
  "email.scanAlert.textFlagged": "{{sitter}} flagged:",
  "email.scanAlert.textNotesLabel": "Sitter notes:",
  "email.scanAlert.textCta": "View the full health check",

  // Flagged-scan reason lines, rendered from structured triage codes. English
  // must byte-match the composed prose ("Concerning: <question, no ?>").
  // "normal" is the unflagged answer, so it never appears in a reason line —
  // it is here because the health-check letter shows all three pills.
  "email.scanReason.normal": "Normal",
  "email.scanReason.concerning": "Concerning",
  "email.scanReason.notSure": "Not sure",
  "email.scanReason.q.alertness": "Is the bird alert and responsive",
  "email.scanReason.q.food": "Is the bird eating normally",
  "email.scanReason.q.droppings": "Do the droppings look normal",
  "email.scanReason.q.breathing": "Is the bird breathing normally",
  "email.scanReason.q.posture": "Is the bird perched normally",
  "email.scanReason.q.noise": "Is the bird vocalizing as usual",
  "email.scanReason.q.fluffed": "Is the bird fluffed for long stretches",
  "email.scanReason.q.vomiting": "Is the face clean and dry, with no vomiting",
  "email.scanReason.q.injury": "Is the bird free of any injury, fall, bite, or scratch",
  "email.scanReason.q.exposure": "Has the bird been kept away from fumes, unsafe foods, metals, plants, and other pets",

  // ── Welcome, sitter concern, bereavement (added 2026-09-23) ──
  "email.welcome.subject": "Welcome to Kya & Co.!",
  "email.welcome.preview": "A health record for your bird, built a few minutes at a time.",
  "email.welcome.kicker": "Welcome",
  "email.welcome.heading": "A record for your bird starts here",
  "email.welcome.hiName": "Hi {{firstName}},",
  "email.welcome.hiNoName": "Hi there,",
  "email.welcome.founder": "I'm Brittany, founder of The Kya Project.",
  "email.welcome.birds": "I love my birds more than anything. But parrots are still wild animals, which means the right diet, real enrichment, and a close eye for anything that seems off is really important.",
  "email.welcome.built": "I built Kya &amp; Co. so my birds get that care every single day, whether I'm home or someone else is filling in.",
  "email.welcome.startThisWeek": "Here's where to start this week:",
  "email.welcome.stepAddBird": "<b>Add your bird.</b> Start with their name and species. You can build their record from there.",
  "email.welcome.stepWeight": "<b>Log a first weight.</b> A digital gram scale lets you keep track of their weight over time. I'll cover choosing and using one in the next email.",
  "email.welcome.stepScan": "<b>Run a daily health check.</b> It takes you through a few questions about how your bird looks and behaves. The normal days count too, because they give you something to compare when things change.",
  "email.welcome.together": "Together, those weights and observations build a record you can bring to your vet.",
  "email.welcome.signoff": "Warmly,<br>Brittany",
  "email.welcome.heroAlt": "A green-cheeked conure perched on an outstretched hand",
  "email.welcome.cta": "Open Kya &amp; Co.",
  "email.welcome.nextUp": "Next, I'll cover weighing your bird and what to look for in a scale.",
  "email.welcome.healthNote": "This app doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.",
  "email.welcome.foot": "You're getting this because you just created an account with Kya &amp; Co. You can turn off emails like this one in Settings at any time.",
  "email.welcome.text": "Hi,\n\nI'm Brittany, founder of The Kya Project.\n\nI love my birds more than anything. But parrots are still wild animals, which means the right diet, real enrichment, and a close eye for anything that seems off is really important.\n\nI built Kya & Co. so my birds get that care every single day, whether I'm home or someone else is filling in.\n\nHere's where to start this week:\n- Add your bird. Start with their name and species. You can build their record from there.\n- Log a first weight. A digital gram scale lets you keep track of their weight over time.\n- Run a daily health check. It takes you through a few questions about how your bird looks and behaves.\n\nTogether, those weights and observations build a record you can bring to your vet.\n\nOver the next few weeks, I'll send you a short email every three days. Each one shows you how a piece of the app works.\n\nOpen Kya & Co.: {{link}}\n\nIf you have a question, or just want to tell me about your bird, reply to this email. It comes straight to me!\n\nWarmly,\nBrittany\n\nThis app doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.\n\nKya & Co. \u2014 by The Kya Project",

  // ── Onboarding series, days 3 to 18 ──────────────────────────────────────
  "email.seriesWeighing.subject": "Weighing your bird",
  "email.seriesWeighing.preview": "What you need, and how to get a useful reading.",
  "email.seriesWeighing.kicker": "Getting started",
  "email.seriesWeighing.heading": "Weighing your bird",
  "email.seriesWeighing.lead": "Keeping track of your bird's weight helps you get to know what's usual for them. Weight loss can be an early sign that something has changed, even when your bird looks much the same.",
  "email.seriesWeighing.card1Label": "What you need",
  "email.seriesWeighing.card1Li1": "A digital scale that reads in grams, with enough capacity for your bird and any perch or container you use.",
  "email.seriesWeighing.card1Li2": "A stable place for your bird to stand. If you use a perch or container, put it on the scale first and press tare to reset the number to zero. Then add your bird. You can also get a scale specially made for weighing birds, with a perch built in.",
  "email.seriesWeighing.p2": "Try to weigh at roughly the same time and at the same point in their usual feeding routine. That makes the readings easier to compare. Follow any instructions your vet has given you.",
  "email.seriesWeighing.p3": "If the scale is new to your bird, give them time to get comfortable with it. You don't need to force a first reading.",
  "email.seriesWeighing.p4": "Over time, the record gives you more to go on than a single weight. If a change worries you, contact your avian vet. You don't need to wait until you have more readings.",
  "email.seriesWeighing.heroAlt": "A ring-necked parakeet standing on an open palm",
  "email.seriesWeighing.momentLabel": "Weight",
  "email.seriesWeighing.momentValue": "752&nbsp;g",
  "email.seriesWeighing.momentSummary": "Steady over the last 90 days.",
  "email.seriesWeighing.momentAxisStart": "90 days ago",
  "email.seriesWeighing.momentAxisEnd": "Today",
  "email.seriesWeighing.momentCaption": "Juno, a blue-throated macaw, weighed before breakfast most mornings. Ninety days of readings, one line.",
  "email.seriesWeighing.cta": "Log a weight",
  "email.seriesWeighing.nextUp": "Next, I'll explain what the daily health check helps you notice and record.",
  "email.seriesWeighing.healthNote": "This app doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.",
  "email.seriesWeighing.foot": "You're getting this as part of your introduction to Kya &amp; Co. You can turn off emails like this one in Settings at any time.",
  "email.seriesWeighing.text": "Keeping track of your bird's weight helps you get to know what's usual for them. Weight loss can be an early sign that something has changed, even when your bird looks much the same.\n\nA digital scale that reads in grams, with enough capacity for your bird and any perch or container you use.\n\nA stable place for your bird to stand. If you use a perch or container, put it on the scale first and press tare to reset the number to zero. Then add your bird. You can also get a scale specially made for weighing birds, with a perch built in.\n\nTry to weigh at roughly the same time and at the same point in their usual feeding routine. That makes the readings easier to compare. Follow any instructions your vet has given you.\n\nIf the scale is new to your bird, give them time to get comfortable with it. You don't need to force a first reading.\n\nOver time, the record gives you more to go on than a single weight. If a change worries you, contact your avian vet. You don't need to wait until you have more readings.\n\nOpen Kya & Co.: {{link}}\n\nThis app doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.\n\nKya & Co. — by The Kya Project",
  "email.seriesHealthCheck.subject": "The daily health check",
  "email.seriesHealthCheck.preview": "What the questions are looking for, and why the normal days count.",
  "email.seriesHealthCheck.kicker": "A daily habit",
  "email.seriesHealthCheck.heading": "The daily health check",
  "email.seriesHealthCheck.lead": "The daily check is a short set of questions about how your bird looks and behaves. It asks about things like alertness, appetite, droppings, breathing, and posture.",
  "email.seriesHealthCheck.p2": "Working through the same questions helps you pay attention to those details. It also leaves you a record to look back on when you're trying to remember when something changed.",
  "email.seriesHealthCheck.card1Label": "Worth knowing",
  "email.seriesHealthCheck.card1P1": "The normal days belong in the record too. If your bird seems quieter than usual, it helps to be able to look back at what you've been seeing over the past few days.",
  "email.seriesHealthCheck.p3": "The check can't confirm that your bird is healthy. If something worries you, contact your avian vet, even if the app hasn't flagged anything.",
  "email.seriesHealthCheck.heroAlt": "A close-up of a green conure with red markings on its face",
  "email.seriesHealthCheck.momentTitle": "Health check — Juno",
  "email.seriesHealthCheck.momentIntro": "A quick once-over to make sure Juno's feeling like themselves.",
  // Question-shaped, with the mark. The email.scanReason.q.* keys are the same
  // questions WITHOUT punctuation, because a reason line composes them as
  // "Concerning: <question>" and must byte-match that — so they are not reused here.
  "email.seriesHealthCheck.q1": "Is the bird alert and responsive?",
  "email.seriesHealthCheck.q2": "Is the bird eating normally?",
  "email.seriesHealthCheck.q3": "Do the droppings look normal?",
  "email.seriesHealthCheck.more": "And a few more, about breathing, perching, and sound.",
  "email.seriesHealthCheck.cta": "Run a health check",
  "email.seriesHealthCheck.nextUp": "Next, we'll look at writing down your bird's everyday routine in the care plan.",
  "email.seriesHealthCheck.healthNote": "This app doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.",
  "email.seriesHealthCheck.foot": "You're getting this as part of your introduction to Kya &amp; Co. You can turn off emails like this one in Settings at any time.",
  "email.seriesHealthCheck.text": "The daily check is a short set of questions about how your bird looks and behaves. It asks about things like alertness, appetite, droppings, breathing, and posture.\n\nWorking through the same questions helps you pay attention to those details. It also leaves you a record to look back on when you're trying to remember when something changed.\n\nThe normal days belong in the record too. If your bird seems quieter than usual, it helps to be able to look back at what you've been seeing over the past few days.\n\nThe check can't confirm that your bird is healthy. If something worries you, contact your avian vet, even if the app hasn't flagged anything.\n\nOpen Kya & Co.: {{link}}\n\nThis app doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.\n\nKya & Co. — by The Kya Project",
  "email.seriesCarePlan.subject": "Writing down what normal looks like",
  "email.seriesCarePlan.preview": "Six sections, and you don't have to do them all at once.",
  "email.seriesCarePlan.kicker": "The care plan",
  "email.seriesCarePlan.heading": "Writing down what normal looks like",
  "email.seriesCarePlan.lead": "The care plan is where you keep what you know about your bird's care. It has six sections: Food, Routine, Behavior, Home, Health, and Emergency.",
  "email.seriesCarePlan.p2": "You don't have to fill in every section right away. Food and Routine are useful places to start, since those are things you'd need to explain to someone else looking after your bird.",
  "email.seriesCarePlan.card1Label": "Make the details useful",
  "email.seriesCarePlan.card1P1": "Write it as if the person reading it hasn't cared for your bird before. What do you offer at breakfast, and how much? When do they settle down for the night? What does someone need to know to follow that routine?",
  "email.seriesCarePlan.p3": "In Behavior, include what your bird enjoys and how they spend their day. Enrichment belongs in the care plan too.",
  "email.seriesCarePlan.p4": "The plan is as much for you as for anyone else. It gives you one place to check the details and update them when their care changes.",
  "email.seriesCarePlan.p5": "It's also what you share when someone else looks after your bird, which I'll cover in a few days.",
  "email.seriesCarePlan.heroAlt": "A peach-faced lovebird eating seed from cupped hands",
  // The six section names, pipe-separated in one key so a translator sees them
  // together and the order cannot drift from the app. Split on "|" at render.
  "email.seriesCarePlan.sections": "Food|Routine|Behavior|Home|Health|Emergency",
  "email.seriesCarePlan.momentCaption": "Six sections. The two in green are the easiest place to begin.",
  "email.seriesCarePlan.cta": "Open the care plan",
  "email.seriesCarePlan.nextUp": "Next, there's a place for the stories, photos, and dates you want to remember.",
  "email.seriesCarePlan.foot": "You're getting this as part of your introduction to Kya &amp; Co. You can turn off emails like this one in Settings at any time.",
  "email.seriesCarePlan.text": "The care plan is where you keep what you know about your bird's care. It has six sections: Food, Routine, Behavior, Home, Health, and Emergency.\n\nYou don't have to fill in every section right away. Food and Routine are useful places to start, since those are things you'd need to explain to someone else looking after your bird.\n\nWrite it as if the person reading it hasn't cared for your bird before. What do you offer at breakfast, and how much? When do they settle down for the night? What does someone need to know to follow that routine?\n\nIn Behavior, include what your bird enjoys and how they spend their day. Enrichment belongs in the care plan too.\n\nThe plan is as much for you as for anyone else. It gives you one place to check the details and update them when their care changes.\n\nIt's also what you share when someone else looks after your bird, which I'll cover in a few days.\n\nOpen Kya & Co.: {{link}}\n\nKya & Co. — by The Kya Project",
  "email.seriesJournal.subject": "The bits worth remembering",
  "email.seriesJournal.preview": "A place for the stories, photos, and important dates.",
  "email.seriesJournal.kicker": "Journal and moments",
  "email.seriesJournal.heading": "The bits worth remembering",
  "email.seriesJournal.lead": "The journal is for the things you want to remember about living with your bird: the first time they said something new, a photo from a good afternoon, the week they decided they hated the vacuum cleaner.",
  "email.seriesJournal.p2": "An entry can be short. A sentence about what happened that day is enough.",
  "email.seriesJournal.p3": "Moments work a little differently. They're the dates you want to hold on to, like a hatch day or the day your bird came home.",
  "email.seriesJournal.p4": "You can keep everyday observations in the journal too. How they got on with a new foraging activity, or something you want to mention at their next vet appointment. Having the date and details written down can help later.",
  "email.seriesJournal.p5": "There's no schedule to keep up with here. Add something when there's something you want to remember.",
  "email.seriesJournal.heroAlt": "A rainbow lorikeet preening its tail feathers on a rope perch",
  "email.seriesJournal.entryDate": "Saturday, 14 September",
  "email.seriesJournal.entry": "Tried the new foraging box this morning. Worked it out in under a minute, then ignored it for the rest of the day.",
  "email.seriesJournal.momentLine": "Moment · 3 October, the day Juno came home",
  "email.seriesJournal.cta": "Add a journal entry",
  "email.seriesJournal.nextUp": "Next, I'll explain the two ways to share care when someone else helps.",
  "email.seriesJournal.foot": "You're getting this as part of your introduction to Kya &amp; Co. You can turn off emails like this one in Settings at any time.",
  "email.seriesJournal.text": "The journal is for the things you want to remember about living with your bird: the first time they said something new, a photo from a good afternoon, the week they decided they hated the vacuum cleaner.\n\nAn entry can be short. A sentence about what happened that day is enough.\n\nMoments work a little differently. They're the dates you want to hold on to, like a hatch day or the day your bird came home.\n\nYou can keep everyday observations in the journal too. How they got on with a new foraging activity, or something you want to mention at their next vet appointment. Having the date and details written down can help later.\n\nThere's no schedule to keep up with here. Add something when there's something you want to remember.\n\nOpen Kya & Co.: {{link}}\n\nKya & Co. — by The Kya Project",
  "email.seriesSharing.subject": "When someone else helps",
  "email.seriesSharing.preview": "How sitter links and household access work differently.",
  "email.seriesSharing.kicker": "Sharing access",
  "email.seriesSharing.heading": "Sharing your bird's care",
  "email.seriesSharing.lead": "There are two ways to let someone else help with your bird's care in Kya &amp; Co. Which one you use depends on how they're helping.",
  "email.seriesSharing.card1Label": "Sitter link",
  "email.seriesSharing.card1P1": "A sitter link is for someone looking after your bird during a sit. They can refer to the care plan while you're away.",
  "email.seriesSharing.card2Label": "Household",
  "email.seriesSharing.card2P1": "Household access is for people who help regularly. It's the option for sharing the ongoing work of keeping your bird's record up to date.",
  "email.seriesSharing.heroAlt": "Two hyacinth macaws sitting close together on a rope",
  "email.seriesSharing.sitterAccount": "No account needed. They open a private link.",
  "email.seriesSharing.householdAccount": "They sign in with their own account.",
  "email.seriesSharing.p2": "Before sharing the plan, check that feeding instructions and contact details are current. Talk through anything you'd want to show the person in practice, too.",
  "email.seriesSharing.p3": "The plan gives them somewhere to check the details afterward, so they don't have to remember everything you told them at once.",
  "email.seriesSharing.cta": "Share your care plan",
  "email.seriesSharing.nextUp": "Next, we'll look at taking your bird's record to your vet.",
  "email.seriesSharing.foot": "You're getting this as part of your introduction to Kya &amp; Co. You can turn off emails like this one in Settings at any time.",
  "email.seriesSharing.text": "There are two ways to let someone else help with your bird's care in Kya & Co. Which one you use depends on how they're helping.\n\nA sitter link is for someone looking after your bird during a sit. They can refer to the care plan while you're away.\n\nHousehold access is for people who help regularly. It's the option for sharing the ongoing work of keeping your bird's record up to date.\n\nBefore sharing the plan, check that feeding instructions and contact details are current. Talk through anything you'd want to show the person in practice, too.\n\nThe plan gives them somewhere to check the details afterward, so they don't have to remember everything you told them at once.\n\nOpen Kya & Co.: {{link}}\n\nKya & Co. — by The Kya Project",
  "email.seriesVet.subject": "Taking the record to your vet",
  "email.seriesVet.preview": "Having the dates and details ready when you need them.",
  "email.seriesVet.kicker": "Vet visits",
  "email.seriesVet.heading": "Taking the record to your vet",
  // Replaces seriesVet.lead: the three questions are their own keys now, each a
  // full sentence, so the ruled list can render them as separate rows.
  "email.seriesVet.leadIntro": "The weights and observations you've logged give you something to refer to at a vet appointment.",
  // The vet-summary card: the rows a vet actually looks at. Sample values, the
  // same way the weighing letter shows a sample weight — this is a picture of
  // the record, not the reader's own data.
  "email.seriesVet.heroAlt": "An African grey parrot looking up from a red perch indoors",
  "email.seriesVet.summaryTitle": "Willow's record, at a glance",
  "email.seriesVet.rowWeightLabel": "Weight",
  "email.seriesVet.rowWeightValue": "1,114 g, steady",
  "email.seriesVet.rowWeightSub": " 12 readings over the last 30 days",
  "email.seriesVet.rowChecksLabel": "Daily checks",
  "email.seriesVet.rowChecksValue": "22 of the last 30 days",
  "email.seriesVet.rowChecksSub": "Nothing flagged",
  "email.seriesVet.rowNotesLabel": "Journal",
  "email.seriesVet.rowNotesValue": "4 notes since the last visit",
  "email.seriesVet.rowNotesSub": "Including two about appetite",
  "email.seriesVet.questionsLabel": "Questions your record can answer",
  "email.seriesVet.q1": "When did their appetite change?",
  "email.seriesVet.q2": "What did they weigh before that?",
  "email.seriesVet.q3": "Has it happened once, or a few times?",
  "email.seriesVet.p2": "Having those details in front of you helps you explain what you've noticed. It gives your avian vet more context alongside what they learn from examining your bird.",
  "email.seriesVet.p3": "The vet summary lets you review the information available in your bird's record before a visit. Check that it's up to date, and make a note of anything you want to ask.",
  "email.seriesVet.p4": "Bring whatever you've recorded so far. You don't need a complete record to ask for help, and you shouldn't delay an appointment to collect more entries.",
  "email.seriesVet.p5": "If you have a question, reply and ask. I'd love to hear how you and your bird are getting on.",
  "email.seriesVet.signoff": "Warmly,<br>Brittany",
  "email.seriesVet.cta": "See the vet summary",
  "email.seriesVet.healthNote": "This app doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.",
  "email.seriesVet.foot": "You're getting this as part of your introduction to Kya &amp; Co. You can turn off emails like this one in Settings at any time.",
  "email.seriesVet.text": "The weights and observations you've logged give you something to refer to at a vet appointment. When did their appetite change? What did they weigh before that? Has it happened once, or a few times?\n\nHaving those details in front of you helps you explain what you've noticed. It gives your avian vet more context alongside what they learn from examining your bird.\n\nThe vet summary lets you review the information available in your bird's record before a visit. Check that it's up to date, and make a note of anything you want to ask.\n\nBring whatever you've recorded so far. You don't need a complete record to ask for help, and you shouldn't delay an appointment to collect more entries.\n\nI hope these emails have helped you find your way around. If monthly recaps are on in Settings, you'll also hear from me each month with a look back at your bird's record and a few useful tips.\n\nIf you have a question, reply and ask. I'd love to hear how you and your bird are getting on.\n\nWarmly,\nBrittany\n\nOpen Kya & Co.: {{link}}\n\nThis app doesn't diagnose illness. If you're ever worried about your bird's health, contact an avian veterinarian.\n\nKya & Co. — by The Kya Project",
  "email.sitterConcern.subject": "{{coveringLabel}} flagged something serious about {{birdName}}",
  "email.sitterConcern.kicker": "Please read now",
  "email.sitterConcern.heading": "{{covering}} flagged something serious about {{bird}}",
  "email.sitterConcern.alert": "<b>{{covering}} has paused {{bird}}'s daily reminders</b> and may be trying to reach you. Please call {{covering}} as soon as you can.",
  "email.sitterConcern.body": "Nothing about {{bird}}'s record has changed, and nothing has been deleted. Care is simply on hold until you and they have spoken.",
  "email.sitterConcern.cta": "Open {{bird}}'s record",
  "email.sitterConcern.foot": "This app doesn't diagnose illness. If you're worried about {{bird}}, contact an avian veterinarian.",
  "email.sitterConcern.text": "{{coveringLabel}} paused {{birdName}}'s daily reminders and flagged that something is seriously wrong. Please call {{coveringLabel}} as soon as you can.\n\nNothing about {{birdName}}'s record has changed.\n\nOpen {{birdName}}'s record: {{link}}\n\nThis app doesn't diagnose illness. If you're worried about {{birdName}}, contact an avian veterinarian.\n\nKya & Co. \u2014 by The Kya Project",
  "email.bereavement.subject": "Thinking of you and {{birdName}}",
  "email.bereavement.hiName": "Hi {{firstName}},",
  "email.bereavement.hiNoName": "Hi,",
  "email.bereavement.sorry": "I saw that {{bird}} passed away, and I'm so sorry.",
  "email.bereavement.grief": "Losing a bird is its own kind of grief. They're with us for years, sometimes decades, and they fill a home with a personality that people who haven't lived with a parrot don't always understand. Please be gentle with yourself.",
  "email.bereavement.record": "{{bird}}'s record, journal and moments are safe in Kya &amp; Co. whenever you want to look back. There's nothing you need to do, and you won't get any reminders about {{bird}}.",
  "email.bereavement.story": "If you ever want to share a favorite story about {{bird}}, you can reply to this email. I'd be honored to read it.",
  "email.bereavement.signoff": "Warmly,<br>Brittany",
  "email.bereavement.text": "Hi,\n\nI saw that {{birdName}} passed away, and I'm so sorry.\n\nLosing a bird is its own kind of grief. They're with us for years, sometimes decades, and they fill a home with a personality that people who haven't lived with a parrot don't always understand. Please be gentle with yourself.\n\n{{birdName}}'s record, journal and moments are safe in Kya & Co. whenever you want to look back. There's nothing you need to do, and you won't get any reminders about {{birdName}}.\n\nIf you ever want to share a favorite story about {{birdName}}, you can reply to this email. I'd be honored to read it.\n\nWarmly,\nBrittany"
}
