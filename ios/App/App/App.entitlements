<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Native push (APNs). "development" is correct here even for shipping:
	     Xcode rewrites it to "production" when archiving with a distribution
	     profile. REQUIRES the Push Notifications capability to be enabled on
	     the App ID and the provisioning profile regenerated, or signing fails. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: links on these hosts open the app (see
	     src/lib/appLinks.ts for which paths). REQUIRES the Associated Domains
	     capability on the App ID and a regenerated provisioning profile, or
	     signing fails. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.thekyaproject.com</string>
		<string>applinks:links.thekyaproject.com</string>
	</array>
</dict>
</plist>
