<?xml version="1.0" encoding="UTF-8"?>
<!-- Matches the web app's first screen (src/components/StartupSplash.tsx), so
     launch shows no jump: forest #1a3d2e (LaunchBackground) in light and dark
     mode, and the stacked Kya & Co. lockup (SplashLogo, made from
     public/brand/lockups/stacked-ink.png with its box made transparent) at
     180 points wide. Centered across the width; vertically 22 points above the
     safe area's middle, where the web's logo sits above its spinner. Nothing
     depends on the screen's shape, so it holds on any iPhone, iPad or iPhone
     Duo screen in any orientation. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="17132" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17105"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="SplashLogo" translatesAutoresizingMaskIntoConstraints="NO" id="snD-IY-ifK">
                                <rect key="frame" x="97.5" y="236" width="180" height="151"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="180" id="Wd1-Lg-180"/>
                                    <constraint firstAttribute="width" secondItem="snD-IY-ifK" secondAttribute="height" multiplier="560:470" id="Ar1-Lg-560"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="snD-IY-ifK" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="Cx1-Lg-ctr"/>
                            <constraint firstItem="snD-IY-ifK" firstAttribute="centerY" secondItem="Bcu-3y-fUS" secondAttribute="centerY" constant="-22" id="Cy1-Lg-ctr"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="SplashLogo" width="180" height="151"/>
        <namedColor name="LaunchBackground">
            <color red="0.10196078431372549" green="0.23921568627450981" blue="0.1803921568627451" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
