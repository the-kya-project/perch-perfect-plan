# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Local env — never commit real values (see .env.example for the keys).
# .env currently holds only client-safe values (Supabase URL + publishable key),
# but ignore it so a future edit can't accidentally commit a real secret.
.env
.env.*
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel build output
.vercel

# Backfill script scratch bundles
.backfill-entry.mjs
.backfill-bundle.mjs
# Local env files (vercel link/pull writes these). .env.example is the
# committed template and must stay tracked.
.env*
!.env.example

# Rendered email previews (npm run email:preview) — build output, never committed.
.email-preview/

# The design handback's source images. They ship from public/brand/email/ and
# are byte-identical, so committing them here would duplicate a megabyte.
# templates/, README.md and new-strings.json ARE committed — the preview check
# diffs against templates/.
docs/email-redesign/assets/

# QA harness sessions (never commit a session token)
.qa-sessions/

# Working files that live here but are deliberately not committed.
# appstore-screenshots/ is ~15 MB and the decision is parked in docs/BACKLOG.md;
# git history is permanent, so it must not be swept in by accident.
appstore-screenshots/
_to_delete/

# Under docs/email-redesign/, ignore the untracked scratch build scripts and
# rendered emails, but keep the tracked files AND templates/ visible: templates/
# is the baseline `email:preview --check` compares against, and ignoring the
# whole directory would silently hide a NEW template from git.
docs/email-redesign/*
!docs/email-redesign/README.md
!docs/email-redesign/new-strings.json
!docs/email-redesign/templates/
